# Supabase — API 查詢用 (app_reader, read-only, Transaction Pooler)
SUPABASE_DB_URL=postgresql://app_reader:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase — ETL 寫入用 (etl_writer, Direct Connection)
SUPABASE_ETL_DB_URL=postgresql://etl_writer:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Qwen API Key (DashScope)
QWEN_API_KEY=sk-xxxxxxxxxxxxxxxx

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
