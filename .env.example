# Supabase — API 查詢用 (app_reader, read-only, Transaction Pooler)
SUPABASE_DB_URL=postgresql://app_reader:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase — ETL 寫入用 (etl_writer, Direct Connection)
SUPABASE_ETL_DB_URL=postgresql://etl_writer:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# LLM API (Hugging Face Inference API, OpenAI-compatible)
# Change URL/models to switch providers (e.g. DashScope, Together AI, etc.)
LLM_API_URL=https://router.huggingface.co/v1/chat/completions
LLM_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
LLM_MODEL_PASS1=Qwen/Qwen3-235B-A22B
LLM_MODEL_PASS2=Qwen/Qwen3-8B

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
